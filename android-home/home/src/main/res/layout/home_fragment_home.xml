<?xml version="1.0" encoding="utf-8"?>
<!-- Figma '좌석예보 앱 UI' 02 홈 프레임 구조. 11주차: 우리집 → 국민대 카드 · 추천 카드 · 확률 배지 (헤더 새로고침 · 알림 아이콘은 12주차) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:orientation="vertical">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:text="@string/home_app_title"
        android:textColor="@color/home_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Trip: 우리집 → 국민대 · 평소 정류장 · day.label -->
    <LinearLayout
        android:id="@+id/home_trip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/home_bg_trip"
        android:contentDescription="@string/home_trip_open"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_trip_title"
                android:textColor="@color/home_on_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/home_ic_chevron_right" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_usual_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/home_on_primary"
            android:textSize="14sp" />

        <!-- 칩 3개 (Figma): 날짜 · day.kind · 지금 HH:MM — 값이 없으면 그 칩만 숨김 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_chip_date"
                style="@style/HomeTripChip"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_day_label"
                style="@style/HomeTripChip"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_chip_now"
                style="@style/HomeTripChip"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 추천 요약: recommendation.message 그대로 -->
    <TextView
        android:id="@+id/home_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/home_bg_summary"
        android:padding="14dp"
        android:textColor="@color/home_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 추천 정류장 · 버스 / 정렬 메뉴 (도착 빠른 순 · 환승 적은 순 · 가까운 정류장 순 · 탑승 확률 높은 순) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_section_title"
            android:textColor="@color/home_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableEnd="@drawable/home_ic_sort"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/home_sort_arrival"
            android:textColor="@color/home_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 추천 목록 · 로딩 · 오류 · 빈 목록 · 로그인 필요 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/home_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/home_primary" />

            <TextView
                android:id="@+id/home_state_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/home_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_state_action"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/home_primary"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- 출발 알림 (1순위 조합 기준, 실제 알림은 E 담당) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/home_departure_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:enabled="false"
        android:text="@string/home_departure_alarm" />
</LinearLayout>
