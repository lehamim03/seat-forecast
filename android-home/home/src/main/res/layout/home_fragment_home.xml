<?xml version="1.0" encoding="utf-8"?>
<!-- Figma '좌석예보 앱 UI' 02 홈 프레임 구조. 12월: 출발지 · 도착지 입력 (예전 우리집 → 국민대 카드 자리) · 추천 카드 · 확률 배지 / 12주차: 헤더 새로고침 · 당겨서 새로고침 · 갱신 시각 (알림 아이콘은 E 담당) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:orientation="vertical">

    <!-- Header: 앱 이름 · 새로고침 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_app_title"
            android:textColor="@color/home_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 시연용: 지난 출근길 재생 (날짜 · 시각 고르기) -->
        <ImageButton
            android:id="@+id/home_replay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_replay"
            android:src="@drawable/home_ic_history"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/home_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_refresh"
            android:src="@drawable/home_ic_refresh" />
    </LinearLayout>

    <!-- 출발지 · 도착지 (12월 출발지 · 도착지 모드): 누르면 검색 화면, 오른쪽 바꾸기 · 즐겨찾기 / 아래 칩 3개 -->
    <LinearLayout
        android:id="@+id/home_trip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/home_bg_trip"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="6dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/home_trip_inputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

        <LinearLayout
            android:id="@+id/home_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/home_bg_trip_field"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/home_from_label"
                android:textColor="@color/home_on_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/home_from_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/home_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/home_bg_trip_field"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/home_to_label"
                android:textColor="@color/home_on_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/home_to_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/home_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/home_swap"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_swap"
                    android:src="@drawable/home_ic_swap" />

                <ImageButton
                    android:id="@+id/home_favorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_favorite"
                    android:src="@drawable/home_ic_star" />
            </LinearLayout>
        </LinearLayout>

        <!-- 칩 3개 (Figma): 날짜 · day.kind · 지금 HH:MM — 값이 없으면 그 칩만 숨김 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_chip_date"
                style="@style/HomeTripChip"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_day_label"
                style="@style/HomeTripChip"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_chip_now"
                style="@style/HomeTripChip"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 지난 출근길 재생 중: 재생 시각 · replay.message · note · 실시간으로 돌아가기 -->
    <LinearLayout
        android:id="@+id/home_replay_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/home_bg_option_first"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_replay_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/home_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_replay_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="@string/home_replay_exit"
                android:textColor="@color/home_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_replay_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/home_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/home_replay_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/home_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 추천 요약: recommendation.message 그대로 -->
    <TextView
        android:id="@+id/home_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/home_bg_summary"
        android:padding="14dp"
        android:textColor="@color/home_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 추천 정류장 · 버스 / 정렬 메뉴 (도착 빠른 순 · 환승 적은 순 · 가까운 정류장 순 · 탑승 확률 높은 순) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_section_title"
                android:textColor="@color/home_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 12주차: "07:40 기준 · 3분 전 갱신" / 새로 불러오는 중 / 갱신 실패 -->
            <TextView
                android:id="@+id/home_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/home_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableEnd="@drawable/home_ic_sort"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/home_sort_arrival"
            android:textColor="@color/home_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 추천 목록 · 로딩 · 오류 · 빈 목록 · 로그인 필요 — 아래로 당기면 새로고침 (12주차) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/home_swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/home_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ProgressBar
                    android:id="@+id/home_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/home_primary" />

                <TextView
                    android:id="@+id/home_state_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/home_muted"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_state_action"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/home_primary"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 출발 알림 (1순위 조합 기준, 실제 알림은 E 담당) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/home_departure_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:enabled="false"
        android:text="@string/home_departure_alarm" />
</LinearLayout>
