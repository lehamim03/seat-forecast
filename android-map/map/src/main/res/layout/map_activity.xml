<?xml version="1.0" encoding="utf-8"?>
<!--
  C 지도 (팀 앱 A 홈 · B 대안과 같은 색 · 카드 · 버튼).
  위: 뒤로 · 제목 · 출발 → 도착 / 경로 칩 (1순위 · 2순위 …) / 지도 (전체 보기 · 내 위치 버튼) / 아래 시트: 경로 비교 카드 · 경로 여러 개 보기
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/map_surface"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/map_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/map_back"
            android:src="@drawable/map_ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_title"
                android:textColor="@color/map_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/map_trip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/map_muted"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="현재 위치 → 국민대학교"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- 경로 칩: 출발지 · 도착지 모드는 1순위 · 2순위 …, 예전 모드는 노선 번호 -->
    <HorizontalScrollView
        android:id="@+id/map_routes_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/map_surface"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/map_routes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/map_border" />

    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/map_background">

        <TextView
            android:id="@+id/map_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/map_loading"
            android:textColor="@color/map_muted"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_nearby"
            style="@style/MapButton.Floating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="28dp"
            android:text="@string/map_nearby"
            android:visibility="gone"
            app:icon="@drawable/map_ic_fit"
            app:iconSize="18dp"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/map_locate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/map_bg_fab"
            android:contentDescription="@string/map_locate"
            android:elevation="4dp"
            android:src="@drawable/map_ic_my_location"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/map_road_status"
            style="@style/MapPill"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/map_bg_fab"
            android:elevation="2dp"
            android:text="@string/map_road_matching"
            android:textColor="@color/map_text_body"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 아래 시트 (지도 위로 16dp 겹쳐 둥근 모서리가 보이게) -->
    <LinearLayout
        android:id="@+id/map_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:background="@drawable/map_bg_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/map_bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map_sheet_title"
                android:textColor="@color/map_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/map_source"
                style="@style/MapPill"
                android:background="@drawable/map_bg_pill_unknown"
                android:textColor="@color/map_unknown"
                android:visibility="gone"
                tools:text="실시간 07:41"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/map_comparison"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_choices_action"
            style="@style/MapButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/map_choices_action"
            app:icon="@drawable/map_ic_route"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/map_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/map_legend"
            android:textColor="@color/map_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/map_permission_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/map_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/map_permission_action"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="@string/map_location_button"
                android:textColor="@color/map_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
