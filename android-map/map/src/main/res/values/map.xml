    <!-- 팀 앱 다른 화면(A 홈 · B 대안)과 같은 Material 3 · 같은 색 -->
    <style name="MapTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/map_primary</item>
        <item name="colorOnPrimary">@color/map_on_primary</item>
        <item name="colorSecondary">@color/map_primary</item>
        <item name="colorSecondaryContainer">@color/map_primary_light</item>
        <item name="colorOnSecondaryContainer">@color/map_primary</item>
        <item name="android:colorAccent">@color/map_primary</item>
        <item name="android:colorBackground">@color/map_background</item>
        <item name="android:windowBackground">@color/map_background</item>
        <item name="colorSurface">@color/map_surface</item>
        <item name="colorOnSurface">@color/map_text</item>
        <item name="android:statusBarColor">@color/map_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/MapButton</item>
    </style>

    <!-- A 홈 HomeButton 과 같음 -->
    <style name="MapButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="MapButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/map_primary</item>
        <item name="iconTint">@color/map_primary</item>
        <item name="strokeColor">@color/map_primary</item>
    </style>

    <!-- 지도 위 흰 알약 버튼 (전체 보기) -->
    <style name="MapButton.Floating" parent="Widget.Material3.Button.ElevatedButton">
        <item name="cornerRadius">999dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/map_text_body</item>
        <item name="iconTint">@color/map_text_body</item>
        <item name="backgroundTint">@color/map_surface</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 상태 알약 (B AltPill 과 같음) -->
    <style name="MapPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
