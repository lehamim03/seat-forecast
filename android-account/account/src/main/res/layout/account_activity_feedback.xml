<?xml version="1.0" encoding="utf-8"?>
<!-- 탑승 피드백 (마이페이지 카드와 같은 모양) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/account_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            style="@style/AccountCard"
            android:layout_marginTop="0dp"
            android:background="@drawable/account_bg_card_accent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/account_ic_chat"
                    app:tint="@color/account_primary" />

                <TextView
                    android:id="@+id/account_question"
                    style="@style/AccountRowTitle"
                    android:layout_marginStart="8dp"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/account_prob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/account_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/account_feedback_why"
                android:textColor="@color/account_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/AccountCard"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/AccountLabel"
                android:text="@string/account_feedback_stop" />

            <Spinner
                android:id="@+id/account_stop"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/AccountLabel"
                android:text="@string/account_feedback_route" />

            <Spinner
                android:id="@+id/account_route"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AccountInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/account_memo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/account_feedback_memo"
                    android:inputType="textMultiLine"
                    android:maxLength="200" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_boarded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/account_boarded" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_not_boarded"
                style="@style/AccountButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/account_not_boarded" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/account_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/account_primary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
