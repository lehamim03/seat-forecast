<?xml version="1.0" encoding="utf-8"?>
<!-- 마이페이지 > 탑승 피드백 기록 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/account_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/account_history_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:textColor="@color/account_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/account_feedback_write"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/account_feedback_write" />

        <LinearLayout
            android:id="@+id/account_feedback_list"
            style="@style/AccountCard"
            android:divider="@drawable/account_divider"
            android:dividerPadding="16dp"
            android:showDividers="middle" />

        <ProgressBar
            android:id="@+id/account_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/account_primary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
