<?xml version="1.0" encoding="utf-8"?>
<!-- 다가오는 차 한 대: N번째 · N분 후 · 약 N석 · [탈 차] · 탑승 확률 (걸어가는 동안 지나가는 차는 흐리게) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="30dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/alt_bus_order"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:textColor="@color/alt_muted"
        android:textSize="12sp"
        tools:text="1번째" />

    <TextView
        android:id="@+id/alt_bus_eta"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:textColor="@color/alt_text"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="6분 후" />

    <TextView
        android:id="@+id/alt_bus_seats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/alt_low"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="만석" />

    <TextView
        android:id="@+id/alt_bus_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/alt_bg_first_bus"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:text="@string/alt_bus_first"
        android:textColor="@color/alt_text_body"
        android:textSize="10sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/alt_bus_prob"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/alt_low"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="2%" />
</LinearLayout>
